{
  "name": "ultron-desktop",
  "version": "1.0.2",
  "private": true,
  "description": "ULTRON native Windows desktop shell",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.ultron.assistant",
    "productName": "ULTRON",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.cjs",
      "preload.cjs"
    ],
    "extraResources": [
      {
        "from": "../backend",
        "to": "runtime/backend",
        "filter": [
          "**/*",
          "!data/**",
          "!.venv/**",
          "!__pycache__/**"
        ]
      },
      {
        "from": "../frontend/dist",
        "to": "runtime/frontend/dist",
        "filter": ["**/*"]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "artifactName": "ULTRON-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ULTRON"
    }
  }
}
