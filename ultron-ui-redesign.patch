+}
+.term-sub {
+  font-family: var(--font-mono);
+  font-size: 8.5px; letter-spacing: 0.44em; color: rgba(210, 210, 214, 0.55);
+  margin-top: 5px;
+}
+
+.term-log {
+  flex: 1; min-height: 0; overflow-y: auto; overflow-x: hidden;
+  display: flex; flex-direction: column; gap: 12px;
+  font-family: var(--font-mono);
+  font-size: 12.5px; line-height: 1.55;
+  padding-right: 6px;
+}
+.term-empty { color: var(--red); opacity: 0.8; }
+.term-line { animation: termin 0.22s ease; word-break: break-word; }
+@keyframes termin { from { opacity: 0; transform: translateX(-4px); } }
+.term-you { color: var(--red); font-weight: 700; }
+.term-you-txt { color: #cfd3d8; }
+.term-ai { color: var(--red); font-weight: 700; text-shadow: 0 0 10px var(--neon); }
+.term-ai-txt { color: var(--red-2); }
+.term-thinking .term-ai-txt { color: rgba(255, 59, 59, 0.7); }
+.term-dots::after { content: ""; animation: dots 1.2s steps(4, end) infinite; }
+@keyframes dots { 0% { content: ""; } 25% { content: "."; } 50% { content: ".."; } 75% { content: "..."; } }
+
+.term-prompt { display: flex; align-items: center; gap: 8px; }
+.term-caret { color: var(--red); font-family: var(--font-mono); font-size: 14px; font-weight: 700; }
+.term-input {
+  flex: 1; background: transparent; border: none; outline: none;
+  color: #d8dbe0; font-family: var(--font-mono); font-size: 13px;
+  letter-spacing: 0.04em; caret-color: var(--red);
+}
+.term-input::placeholder { color: rgba(120, 120, 128, 0.4); }
+.term-blink {
+  width: 8px; height: 15px; background: var(--red);
+  box-shadow: 0 0 8px var(--neon);
+  animation: blink 1.05s steps(2, start) infinite; margin-left: -4px;
+}
+@keyframes blink { 50% { opacity: 0; } }
+.term-err { font-family: var(--font-mono); font-size: 10px; color: var(--red); }
+.term-status {
+  display: flex; align-items: center; gap: 7px;
+  font-family: var(--font-mono); font-size: 8.5px; letter-spacing: 0.22em;
+  color: rgba(180, 185, 195, 0.4);
+}
+.term-dot { width: 6px; height: 6px; border-radius: 50%; }
+.term-dot.on { background: var(--green); box-shadow: 0 0 7px var(--green); }
+.term-dot.off { background: var(--amber); box-shadow: 0 0 7px var(--amber); animation: pulse 1s infinite; }
+
+/* ---------------- merkez/sağ: partikül küresi ---------------- */
+.stage-wrap { position: relative; min-height: 0; overflow: hidden; }
+.sphere-stage { position: absolute; inset: 0; }
+.sphere-canvas { position: absolute; inset: 0; }
+.sphere-logo {
+  position: absolute; top: 50%; left: 50%;
+  transform: translate(-50%, -50%);
+  pointer-events: none;
+  filter: drop-shadow(0 0 18px rgba(255, 26, 26, 0.85)) drop-shadow(0 0 42px rgba(255, 26, 26, 0.5));
+}
+
+/* ---------------- alt: Push-To-Talk barı ---------------- */
+.ptt-bar {
+  position: absolute; left: 50%; bottom: 26px; transform: translateX(-50%);
+  display: flex; align-items: center; gap: 14px; z-index: 6;
+  padding: 8px 18px 8px 10px;
+  background: rgba(8, 8, 10, 0.55);
+  border: 1px solid rgba(255, 26, 26, 0.25);
+  border-radius: 999px;
+  backdrop-filter: blur(6px);
+}
+.ptt-btn {
+  width: 44px; height: 44px; border-radius: 50%; flex: none;
+  display: inline-flex; align-items: center; justify-content: center;
+  background: radial-gradient(circle at 35% 30%, rgba(255, 70, 70, 0.5), rgba(120, 8, 8, 0.7));
+  border: 1px solid rgba(255, 26, 26, 0.7); color: #ffe4e4; cursor: pointer;
+  box-shadow: 0 0 18px rgba(255, 26, 26, 0.4);
+  transition: box-shadow 0.2s ease, transform 0.12s ease;
+  touch-action: none;
+}
+.ptt-btn:hover { box-shadow: 0 0 26px rgba(255, 26, 26, 0.6); }
+.ptt-btn:active { transform: scale(0.94); }
+.ptt-btn.live { animation: pttpulse 1.1s ease-in-out infinite; }
+@keyframes pttpulse { 50% { box-shadow: 0 0 34px rgba(255, 26, 26, 0.9); } }
+.ptt-meta { display: flex; flex-direction: column; line-height: 1.2; }
+.ptt-label {
+  font-family: var(--font-mono); font-size: 8px; letter-spacing: 0.3em;
+  color: rgba(200, 200, 205, 0.45);
+}
+.ptt-phase {
+  font-family: var(--font-mono); font-size: 12px; font-weight: 700; letter-spacing: 0.22em;
+  margin-top: 2px;
+}
+.ptt-phase.p-idle { color: rgba(200, 200, 205, 0.6); }
+.ptt-phase.p-listening { color: var(--red); text-shadow: 0 0 10px var(--neon); animation: pulse 1s infinite; }
+.ptt-phase.p-thinking { color: var(--red-2); text-shadow: 0 0 10px var(--neon); }
+.ptt-phase.p-speaking { color: #ff6a6a; text-shadow: 0 0 12px var(--neon); }
